# ---------------------------------------------------------------------------
# OpenLLM Gateway — example configuration
#
#   cp .env.example .env
#
# Every value below has a working default except DATABASE_URL and REDIS_URL.
# The gateway validates all of this at boot and refuses to start on bad input,
# reporting every problem at once rather than one per restart.
#
# NOTE: when running under `docker compose`, DATABASE_URL and REDIS_URL are set
# by the compose file to point at the compose services. The values here are for
# running the gateway directly on your machine (`pnpm dev`).
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# --- Datastores (required) -------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openllm
REDIS_URL=redis://localhost:6379

# --- Postgres pool ---------------------------------------------------------
# Bounded on purpose: an unbounded pool turns a traffic spike into a
# database-wide outage instead of backpressure.
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000

# --- HTTP ------------------------------------------------------------------
# Maximum accepted request body, in bytes (1 MiB).
BODY_LIMIT_BYTES=1048576
# Comma-separated allowlist. Empty means CORS is disabled — NOT "allow all".
CORS_ORIGINS=

# --- Readiness probe -------------------------------------------------------
READINESS_CHECK_TIMEOUT_MS=2000
# Brief cache so a polling load balancer does not generate constant background
# load against Postgres and Redis.
READINESS_CACHE_MS=1000

# --- Reliability -----------------------------------------------------------
# Ceiling on a single provider call. Enforced with an AbortSignal, so a timeout
# actually cancels the upstream request instead of leaving it generating tokens
# nobody will read.
PROVIDER_TIMEOUT_MS=30000
# Budget for the WHOLE operation — every retry and every fallback combined.
# Distinct from PROVIDER_TIMEOUT_MS, which bounds a single call. Without it,
# 3 targets x 3 attempts x 30s is minutes for a request the caller abandoned.
REQUEST_TIMEOUT_MS=60000

# --- Retry ---------------------------------------------------------------
# Attempts are per target; fallback then moves to the next provider.
# Backoff follows 250ms, 500ms, 1000ms ... capped at RETRY_MAX_DELAY_MS.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=250
RETRY_MAX_DELAY_MS=5000
# Randomize the delay. Without jitter, every client that hit the same provider
# outage retries at the same instant and re-creates the spike that caused it.
RETRY_JITTER=true

# --- Redis features (spec §12) ----------------------------------------------
# Namespaces every key, so several gateways can share one Redis:
#   openllm:v1:rl:key:...   openllm:v1:cache:...   openllm:v1:health:...
REDIS_KEY_PREFIX=openllm

# Rate limiting. A token bucket, so "cost" is a parameter — requests/minute is
# cost 1 today, and tokens/minute will be cost N with no rewrite.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Bucket size — how much of the budget may be spent at once. Defaults to the rate.
# RATE_LIMIT_BURST=60
# Allow requests through when Redis is unreachable. On by default: a limiter
# that rejects everything during a Redis blip is itself the outage.
RATE_LIMIT_FAIL_OPEN=true

# Exact-match response cache.
#
# OFF BY DEFAULT because enabling it stores COMPLETION TEXT in Redis for the
# TTL. That is a real cost saving in exchange for a real privacy trade, and the
# operator should be the one making it (spec §14, §26). Cache keys are hashes,
# so prompts are not recoverable from keys — but anyone who can read Redis can
# read the cached completions.
#
# It also makes repeated identical calls deterministic even at temperature > 0.
CACHE_ENABLED=false
CACHE_TTL_SECONDS=300
# global = share entries across callers; api-key = isolate per key.
CACHE_SCOPE=global

# Skip providers that are failing instead of paying their timeout every request.
BREAKER_ENABLED=true
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=30

# --- Request recording (spec §14, §15) --------------------------------------
# One metadata row per request: provider, model, status, latency, token counts,
# estimated cost. NEVER message content — the table has no column for it.
#
# Writes are buffered and batched off the request path, so Postgres is never in
# the critical path of a request and a write failure loses metrics, not traffic.
REQUEST_RECORDING_ENABLED=true
REQUEST_RECORDING_BATCH_SIZE=50
REQUEST_RECORDING_FLUSH_MS=1000
# Ceiling on buffered records. Past it the oldest are dropped and counted — an
# unbounded buffer during a Postgres outage is just a slower crash.
REQUEST_RECORDING_MAX_BUFFER=10000

# --- Request retention ------------------------------------------------------
# Days of request history to keep. A table nothing ever deletes from grows until
# queries crawl — at 100 req/s that is ~260M rows a year.
#
# Set 0 to keep everything forever, if you ship this data somewhere else.
REQUEST_RETENTION_DAYS=90
# Pruning runs on a timer, deletes in small batches so locks stay short, and is
# guarded by a Postgres advisory lock so only one replica prunes per round.
REQUEST_PRUNE_INTERVAL_MS=3600000
REQUEST_PRUNE_BATCH_SIZE=5000
#
# Per-model pricing lives in openllm.yaml, not here — see openllm.example.yaml.

# --- Authentication (spec §13) ----------------------------------------------
# Require an API key on /v1. Defaults to ON in production, OFF elsewhere, so a
# fresh `docker compose up` works before any key exists. A loud warning is
# logged whenever it is off — "auth disabled" is never a quiet state.
# AUTH_REQUIRED=true
#
# Secret for the key-management API at /v1/admin. Environment only, never in the
# database, so a database compromise cannot mint new keys. Unset = /v1/admin off.
# ADMIN_API_KEY=
#
# Read-only credential for the dashboard's stats endpoints.
#
# SEPARATE FROM ADMIN_API_KEY on purpose. The dashboard is a browser app, and
# whatever key it holds is one XSS away from being stolen — that must not be a
# key that can mint API keys. This one can only read request metadata.
# DASHBOARD_API_KEY=
#
# Bootstrap a key without the admin API:
#   pnpm key:create "my-app"
#
# Keys are stored ONLY as SHA-256 hashes and shown exactly once at creation.

# --- Database migrations ----------------------------------------------------
# Migrations run at boot by default, serialized across replicas by a Postgres
# advisory lock. Set true where a separate deploy step runs them.
SKIP_MIGRATIONS=false

# --- Graceful shutdown -----------------------------------------------------
# Time spent failing /ready before closing the server, so the load balancer
# stops routing to this instance first. This is what makes deploys blip-free.
SHUTDOWN_DRAIN_MS=5000
# Hard deadline for the whole shutdown sequence.
SHUTDOWN_TIMEOUT_MS=15000
# How long to let in-flight STREAMED responses finish before aborting them.
# A streamed completion can run for tens of seconds; cutting it mid-sentence
# loses work the user has already been billed for.
SHUTDOWN_STREAM_GRACE_MS=10000

# ---------------------------------------------------------------------------
# Providers
#
# A provider is ENABLED when its credential is set — an API key for the hosted
# providers, a base URL for Ollama. There is no separate *_ENABLED flag, because
# a provider that is "enabled" with no way to authenticate is not a useful state.
#
# Leave a key blank or unset to keep that provider switched off.
#
# Keys are never exposed through the API or the dashboard, and never logged:
# the logger strips anything key-shaped before it reaches a log line.
# ---------------------------------------------------------------------------

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=
# Override to point at any OpenAI-compatible server (vLLM, LM Studio, a proxy).
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini ---------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# --- Ollama (optional) -----------------------------------------------------
# Commented out on purpose: setting this is what enables Ollama. Uncomment only
# if you actually have Ollama running, otherwise its health checks will fail.
#   docker compose --profile ollama up
# OLLAMA_BASE_URL=http://localhost:11434

# --- Mock provider (spec §17) ----------------------------------------------
# Exercises retries, fallback and timeouts without spending API credits.
# Enabled automatically outside production; set explicitly to override.
# MOCK_PROVIDER_ENABLED=true
#
# Drive behaviour per request through the model name:
#   mock                  success
#   mock/echo             returns your last user message
#   mock/rate-limited     429   (retryable)
#   mock/server-error     500   (retryable)
#   mock/unavailable      503   (retryable)
#   mock/invalid          400   (NOT retryable — proves no pointless failover)
#   mock/auth-error       401   (NOT retryable)
#   mock/model-not-found  404   (NOT retryable)
#   mock/timeout          never responds, until your timeout fires
#
# Or globally, for soak testing under intermittent failure:
MOCK_LATENCY_MS=0
# Delay between streamed chunks. Set to e.g. 120 to watch SSE arrive
# incrementally and to verify your proxy is not buffering the stream.
MOCK_CHUNK_DELAY_MS=0
MOCK_FAILURE_RATE=0
