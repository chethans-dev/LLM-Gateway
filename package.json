{
  "name": "openllm-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, OpenAI-compatible LLM gateway with routing, fallback, rate limiting and observability",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @openllm/core build && pnpm --filter @openllm/gateway dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "db:generate": "pnpm --filter @openllm/gateway db:generate",
    "db:migrate": "pnpm --filter @openllm/gateway db:migrate",
    "clean": "pnpm -r clean",
    "key:create": "pnpm --filter @openllm/gateway key:create",
    "test:coverage": "vitest run --project unit --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.0"
  }
}
